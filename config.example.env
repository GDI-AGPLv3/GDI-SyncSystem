# GDI Sync System - Configuracion
# Copiar este archivo a .env y completar los valores

# API Key de backup (la provee GDI Latam)
GDI_API_KEY=sk-gdi-COMPLETAR

# URL del Gateway del municipio (la provee GDI Latam)
GDI_GATEWAY_URL=https://tu-municipio-gateway.gdilatam.com

# Ruta del archivo de base de datos local (opcional, default: backup.db)
# GDI_DB_PATH=backup.db

# Carpeta donde se guardan los PDFs descargados (opcional, default: pdfs/)
# GDI_PDF_DIR=pdfs
